---
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');
const posts = allDocs
	.filter((entry) => {
		const slug = entry.id || entry.slug || '';
		return slug.startsWith('blog/') && slug !== 'blog.md' && slug !== 'blog';
	})
	.sort((a, b) => {
		const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
		const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;
		return bTime - aTime;
	});

const formatDate = (date: Date | undefined) => {
	if (!date) return '';
	return date.toLocaleDateString('zh-CN', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
	});
};
---

<ul class="post-list">
	{posts.map((post) => {
		const slug = post.slug || post.id;
		return (
			<li class="post-item">
				<a class="post-link" href={`/${slug}/`}>
					<span class="post-title">{post.data.title}</span>
					{post.data.date && (
						<span class="post-date">{formatDate(post.data.date)}</span>
					)}
				</a>
			</li>
		);
	})}
</ul>

<style>
	.post-list {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.post-item {
		margin: 0;
		padding: 0;
	}

	.post-link {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.75rem 1rem;
		border-radius: 8px;
		color: inherit;
		text-decoration: none;
		background: var(--sl-color-gray-7);
		border: 1px solid var(--sl-color-gray-6);
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.post-link:hover {
		background: var(--sl-color-gray-6);
		border-color: var(--sl-color-gray-5);
	}

	.post-title {
		font-size: 1rem;
		font-weight: 500;
		color: var(--sl-color-gray-1);
	}

	.post-date {
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		flex-shrink: 0;
		margin-left: 1rem;
		font-family: monospace;
	}

	@media (max-width: 480px) {
		.post-link {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}

		.post-date {
			margin-left: 0;
		}
	}
</style>
